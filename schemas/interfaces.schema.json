{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kavernis.example/schemas/interfaces.schema.json",
  "title": "Kavernis interfaces configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "interfaces"],
  "properties": {
    "version": {"const": 1},
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/interface"}
    }
  },
  "$defs": {
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "id", "name", "device", "ipv4", "ipv6"],
      "allOf": [{
        "if": {"anyOf": [
          {"required": ["vlan"], "properties": {"vlan": {"type": "object"}}},
          {"required": ["bridge"], "properties": {"bridge": {"type": "object"}}}
        ]},
        "then": {"properties": {"device": {"maxLength": 15, "pattern": "^[A-Za-z0-9_.-]+$", "not": {"enum": [".", ".."]}}}}
      }, {
        "not": {
          "required": ["vlan", "bridge"],
          "properties": {"vlan": {"type": "object"}, "bridge": {"type": "object"}}
        }
      }],
      "properties": {
        "uid": {"type": "string", "format": "uuid"},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "device": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
        "ipv4": {"$ref": "#/$defs/ipv4"},
        "ipv6": {"$ref": "#/$defs/ipv6"},
        "vlan": {"anyOf": [{"$ref": "#/$defs/vlan"}, {"type": "null"}]},
        "bridge": {"anyOf": [{"$ref": "#/$defs/bridge"}, {"type": "null"}]}
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members"],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "stp": {"type": "boolean", "default": true}
      }
    },
    "vlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "tag"],
      "properties": {
        "parent": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "tag": {"type": "integer", "minimum": 1, "maximum": 4094}
      }
    },
    "ipv4": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "address"], "properties": {"mode": {"const": "static"}, "address": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["dhcp", "disabled"]}}}
      ]
    },
    "ipv6": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "address"], "properties": {"mode": {"const": "static"}, "address": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["dhcp6", "slaac", "disabled"]}}}
      ]
    }
  }
}
